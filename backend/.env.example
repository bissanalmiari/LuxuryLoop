# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret

# Session-pooler URL (includes DB password). Enables the RLS session-context
# bridge (per-request SET LOCAL app.current_user_id/role/branch_id).
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.ref:db-password@aws-0-region.pooler.supabase.com:5432/postgres

# App
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,
SITE_URL=http://localhost:3000

# AI authenticity screening (Gemini vision API)
AI_ASSESSMENT_PROVIDER=gemini-3.6-flash
AI_ASSESSMENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/open
AI_ASSESSMENT_API_KEY=your-gemini-api-key

# Appointment email (Resend free tier, 3,000 emails/mo, no card needed)
RESEND_API_KEY=
# Must be a sender verified on Resend (resend.com/domains). onboarding@resend.dev is
# Resend's built-in test sender; for real customer emails verify your own domain first.
EMAIL_FROM=onboarding@resend.dev

STRIPE_SECRET_KEY=